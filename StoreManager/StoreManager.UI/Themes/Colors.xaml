<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Colors -->
    <Color x:Key="PrimaryColor">#1565C0</Color>
    <Color x:Key="PrimaryLightColor">#1976D2</Color>
    <Color x:Key="AccentColor">#FF6F00</Color>
    <Color x:Key="SuccessColor">#2E7D32</Color>
    <Color x:Key="DangerColor">#C62828</Color>
    <Color x:Key="SidebarColor">#0D47A1</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="BackgroundColor">#F5F7FA</Color>
    <Color x:Key="TextColor">#212121</Color>
    <Color x:Key="SubTextColor">#757575</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="SubTextBrush" Color="{StaticResource SubTextColor}"/>

</ResourceDictionary>
