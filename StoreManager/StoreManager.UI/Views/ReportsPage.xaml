<Page x:Class="StoreManager.UI.Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}" FontFamily="Vazir, Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="cbReport" Width="200" SelectionChanged="CbReport_Changed">
                    <ComboBoxItem Content="فروش بر اساس کالا" IsSelected="True"/>
                    <ComboBoxItem Content="گزارش سود"/>
                    <ComboBoxItem Content="بدهی مشتریان"/>
                    <ComboBoxItem Content="کالاهای کم موجود"/>
                </ComboBox>
                <TextBlock Text="از:" Margin="12,0,6,0" VerticalAlignment="Center"/>
                <DatePicker x:Name="dpFrom" Width="130"/>
                <TextBlock Text="تا:" Margin="8,0,6,0" VerticalAlignment="Center"/>
                <DatePicker x:Name="dpTo" Width="130"/>
                <Button Style="{StaticResource PrimaryButton}" Content="نمایش"
                        Margin="8,0,0,0" Click="BtnShow_Click"/>
                <Button Content="خروجی Excel" Margin="8,0,0,0" Padding="12,6"
                        Background="#2E7D32" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="BtnExport_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DataGrid x:Name="dgReport" AutoGenerateColumns="True"/>
        </Border>
    </Grid>
</Page>
