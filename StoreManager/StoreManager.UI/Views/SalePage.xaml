<Page x:Class="StoreManager.UI.Views.SalePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}" FontFamily="Vazir, Segoe UI">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Product search + items -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search product -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="txtProductSearch" Width="250"
                             Tag="جستجوی کالا..." KeyDown="TxtProductSearch_KeyDown"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="جستجو"
                            Margin="8,0,0,0" Click="BtnSearch_Click"/>
                    <Button Content="اسکن بارکد" Margin="8,0,0,0" Padding="12,6"
                            Background="#FF6F00" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Click="BtnBarcode_Click"/>
                </StackPanel>
            </Border>

            <!-- Invoice Items -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="dgItems" Grid.Row="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="کالا" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="واحد" Binding="{Binding Unit}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="تعداد" Binding="{Binding Qty}" Width="70"/>
                            <DataGridTextColumn Header="قیمت" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}" Width="100"/>
                            <DataGridTextColumn Header="تخفیف" Binding="{Binding Discount, StringFormat={}{0:N0}}" Width="80"/>
                            <DataGridTextColumn Header="جمع" Binding="{Binding TotalPrice, StringFormat={}{0:N0}}" Width="100" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="1" Content="حذف ردیف انتخابی"
                            Style="{StaticResource DangerButton}" HorizontalAlignment="Right"
                            Margin="0,8,0,0" Click="BtnRemoveItem_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Right: Summary + Payment -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="اطلاعات فاکتور" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>

                <TextBlock Text="نوع فاکتور" Margin="0,0,0,4"/>
                <ComboBox x:Name="cbType" Margin="0,0,0,12" SelectionChanged="CbType_Changed">
                    <ComboBoxItem Content="فروش" Tag="0"/>
                    <ComboBoxItem Content="خرید" Tag="1"/>
                    <ComboBoxItem Content="برگشت از فروش" Tag="2"/>
                </ComboBox>

                <TextBlock Text="مشتری / طرف حساب" Margin="0,0,0,4"/>
                <ComboBox x:Name="cbCustomer" Margin="0,0,0,12"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          IsEditable="True"/>

                <TextBlock Text="نوع پرداخت" Margin="0,0,0,4"/>
                <ComboBox x:Name="cbPayType" Margin="0,0,0,12">
                    <ComboBoxItem Content="نقدی"/>
                    <ComboBoxItem Content="نسیه"/>
                    <ComboBoxItem Content="کارت‌خوان"/>
                    <ComboBoxItem Content="ترکیبی"/>
                </ComboBox>

                <Separator Margin="0,8"/>

                <Grid Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="جمع کل:" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="lblTotal" Text="0"
                               FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="تخفیف:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtDiscount" Text="0"
                             TextChanged="RecalcTotal" Height="26"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="مالیات:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtTax" Text="0"
                             TextChanged="RecalcTotal" Height="26"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="مبلغ دریافتی:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtPaid" Text="0"
                             TextChanged="RecalcTotal" Height="26"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="قابل پرداخت:"
                               FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="lblFinal" Text="0"
                               FontWeight="Bold" FontSize="14"
                               Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="توضیحات" Margin="0,8,0,4"/>
                <TextBox x:Name="txtDesc" Height="60" TextWrapping="Wrap"
                         AcceptsReturn="True" Margin="0,0,0,12"/>

                <Button Style="{StaticResource SuccessButton}" Content="✔ ثبت فاکتور"
                        FontSize="15" Height="44" Click="BtnSubmit_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
