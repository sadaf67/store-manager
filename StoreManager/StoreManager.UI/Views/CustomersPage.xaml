<Page x:Class="StoreManager.UI.Views.CustomersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}" FontFamily="Vazir, Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Content="+ افزودن مشتری" Click="BtnAdd_Click"/>
                <TextBox x:Name="txtSearch" Width="220" Margin="10,0,0,0"
                         Tag="جستجوی نام یا موبایل..." TextChanged="TxtSearch_TextChanged"/>
                <Button Content="فقط بدهکاران" Margin="8,0,0,0" Padding="12,6"
                        Background="#E65100" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="BtnDebtors_Click"/>
                <Button Style="{StaticResource DangerButton}" Content="حذف"
                        Margin="8,0,0,0" Click="BtnDelete_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DataGrid x:Name="dgCustomers" MouseDoubleClick="DgCustomers_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="70"/>
                    <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="موبایل" Binding="{Binding Mobile}" Width="110"/>
                    <DataGridTextColumn Header="تلفن" Binding="{Binding Phone}" Width="100"/>
                    <DataGridTextColumn Header="مانده (ریال)" Binding="{Binding Balance, StringFormat={}{0:N0}}" Width="120"/>
                    <DataGridTextColumn Header="سقف اعتبار" Binding="{Binding CreditLimit, StringFormat={}{0:N0}}" Width="100"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Balance, Converter={StaticResource NegToBool}}" Value="True">
                                <Setter Property="Background" Value="#FFEBEE"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>
    </Grid>
</Page>
