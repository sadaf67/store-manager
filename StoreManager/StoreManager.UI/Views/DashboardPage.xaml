<Page x:Class="StoreManager.UI.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}" FontFamily="Vazir, Segoe UI">
    <ScrollViewer>
        <StackPanel Margin="24">

            <!-- Stats Cards -->
            <UniformGrid Columns="3" Margin="0,0,0,20">

                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="فروش امروز" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                        <TextBlock x:Name="txtTodaySales" Text="0 ریال"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="فروش این ماه" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                        <TextBlock x:Name="txtMonthSales" Text="0 ریال"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="بدهی مشتریان" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                        <TextBlock x:Name="txtTotalDebt" Text="0 ریال"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <UniformGrid Columns="3" Margin="0,0,0,24">
                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="تعداد کالاها" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                        <TextBlock x:Name="txtProductCount" Text="0"
                                   FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="تعداد مشتریان" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                        <TextBlock x:Name="txtCustomerCount" Text="0"
                                   FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="کالاهای کم موجود" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                        <TextBlock x:Name="txtLowStock" Text="0"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Low Stock Alert -->
            <Border x:Name="pnlLowStock" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="⚠ هشدار کم موجودی" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" FontSize="14" Margin="0,0,0,10"/>
                    <DataGrid x:Name="dgLowStock" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="کالا" Binding="{Binding کالا}" Width="*"/>
                            <DataGridTextColumn Header="موجودی" Binding="{Binding موجودی}" Width="80"/>
                            <DataGridTextColumn Header="حداقل" Binding="{Binding حداقل_موجودی}" Width="80"/>
                            <DataGridTextColumn Header="واحد" Binding="{Binding واحد}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
