<Window x:Class="StoreManager.UI.Views.ProductPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="انتخاب کالا" Width="500" Height="400"
        WindowStartupLocation="CenterOwner" FontFamily="Vazir, Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="dgProducts" Grid.Row="0" MouseDoubleClick="DgProducts_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="کد" Binding="{Binding Code}" Width="80"/>
                <DataGridTextColumn Header="نام کالا" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="موجودی" Binding="{Binding Stock}" Width="80"/>
                <DataGridTextColumn Header="قیمت" Binding="{Binding SellPrice, StringFormat={}{0:N0}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="1" Content="انتخاب" Style="{StaticResource PrimaryButton}"
                Margin="0,10,0,0" Click="BtnSelect_Click"/>
    </Grid>
</Window>
