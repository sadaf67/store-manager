<Window x:Class="StoreManager.UI.Views.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="رسید فاکتور" Width="420" Height="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FontFamily="Vazir, Segoe UI">
    <Window.Resources>
        <!-- استایل برای ردیف‌های جدول رسید -->
        <Style x:Key="ReceiptRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <!-- خط جداکننده رسید -->
        <Style x:Key="Divider" TargetType="Separator">
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Background" Value="#BDBDBD"/>
        </Style>
    </Window.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- بخش اصلی رسید (اسکرول‌پذیر) -->
            <RowDefinition Height="Auto"/>
            <!-- دکمه‌های عملیاتی -->
        </Grid.RowDefinitions>

        <!-- بخش اصلی رسید - اسکرول‌پذیر برای فاکتورهای طولانی -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <!-- هدر فروشگاه -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock x:Name="txtStoreName"
                               FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="#1565C0"/>
                    <TextBlock x:Name="txtStoreType"
                               FontSize="11" HorizontalAlignment="Center"
                               Foreground="#757575" Margin="0,2"/>
                    <TextBlock x:Name="txtStorePhone"
                               FontSize="11" HorizontalAlignment="Center"
                               Foreground="#757575"/>
                    <TextBlock x:Name="txtStoreAddress"
                               FontSize="10" HorizontalAlignment="Center"
                               Foreground="#9E9E9E" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,2"/>
                </StackPanel>

                <Separator Style="{StaticResource Divider}"/>

                <!-- اطلاعات فاکتور -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>

                    <!-- شماره فاکتور -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="شماره فاکتور:"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtInvoiceNo"
                               Foreground="#1565C0" FontWeight="Bold"
                               HorizontalAlignment="Left" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>

                    <!-- تاریخ -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="تاریخ و ساعت:"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtDate"
                               HorizontalAlignment="Left" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>

                    <!-- مشتری -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="مشتری:"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtCustomer"
                               HorizontalAlignment="Left" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>

                    <!-- نوع پرداخت -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="نوع پرداخت:"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtPayType"
                               HorizontalAlignment="Left" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>

                <Separator Style="{StaticResource Divider}"/>

                <!-- هدر جدول اقلام -->
                <Grid Background="#1565C0" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- نام کالا -->
                        <ColumnDefinition Width="50"/>
                        <!-- تعداد -->
                        <ColumnDefinition Width="70"/>
                        <!-- قیمت واحد -->
                        <ColumnDefinition Width="80"/>
                        <!-- جمع -->
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="کالا" Foreground="White"
                               FontWeight="Bold" Padding="6,4" FontSize="11"/>
                    <TextBlock Grid.Column="1" Text="تعداد" Foreground="White"
                               FontWeight="Bold" Padding="4" FontSize="11" TextAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="قیمت" Foreground="White"
                               FontWeight="Bold" Padding="4" FontSize="11" TextAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="جمع" Foreground="White"
                               FontWeight="Bold" Padding="4,4,8,4" FontSize="11" TextAlignment="Left"/>
                </Grid>

                <!-- لیست اقلام فاکتور - داینامیک توسط کد -->
                <ItemsControl x:Name="lstItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- هر ردیف کالا در رسید -->
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Grid.Background>
                                    <!-- پس‌زمینه یک‌در‌میان برای خوانایی بهتر -->
                                    <SolidColorBrush Color="#F9F9F9"/>
                                </Grid.Background>
                                <TextBlock Grid.Column="0" Text="{Binding ProductName}"
                                           Padding="6,3" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="{Binding Qty}"
                                           Padding="4,3" FontSize="11" TextAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding UnitPrice, StringFormat={}{0:N0}}"
                                           Padding="4,3" FontSize="10" TextAlignment="Center"/>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding TotalPrice, StringFormat={}{0:N0}}"
                                           Padding="4,3,8,3" FontSize="11" TextAlignment="Left"
                                           FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Style="{StaticResource Divider}"/>

                <!-- جمع‌بندی مالی -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="32"/>
                        <!-- ردیف مبلغ نهایی - بزرگ‌تر -->
                        <RowDefinition Height="26"/>
                        <RowDefinition Height="26"/>
                    </Grid.RowDefinitions>

                    <!-- جمع کل -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="جمع کل اقلام:"
                               VerticalAlignment="Center" FontSize="12"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtTotal"
                               VerticalAlignment="Center" FontSize="12" HorizontalAlignment="Left"/>

                    <!-- تخفیف -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="تخفیف:"
                               VerticalAlignment="Center" FontSize="12" Foreground="#E65100"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtDiscount"
                               VerticalAlignment="Center" FontSize="12"
                               Foreground="#E65100" HorizontalAlignment="Left"/>

                    <!-- مالیات -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="مالیات:"
                               VerticalAlignment="Center" FontSize="12"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtTax"
                               VerticalAlignment="Center" FontSize="12" HorizontalAlignment="Left"/>

                    <!-- مبلغ نهایی - برجسته‌تر -->
                    <Border Grid.Row="3" Grid.ColumnSpan="2"
                            Background="#E3F2FD" CornerRadius="6" Padding="8,4" Margin="0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="مبلغ قابل پرداخت:"
                                       FontWeight="Bold" FontSize="14"
                                       Foreground="#1565C0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="txtFinal"
                                       FontWeight="Bold" FontSize="14"
                                       Foreground="#1565C0" HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- مبلغ پرداخت شده -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="دریافت شده:"
                               VerticalAlignment="Center" FontSize="12" Foreground="#2E7D32"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtPaid"
                               VerticalAlignment="Center" FontSize="12"
                               Foreground="#2E7D32" HorizontalAlignment="Left"/>

                    <!-- مانده -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="مانده:"
                               VerticalAlignment="Center" FontSize="12" Foreground="#C62828"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="txtRemain"
                               VerticalAlignment="Center" FontSize="12"
                               Foreground="#C62828" HorizontalAlignment="Left"/>
                </Grid>

                <Separator Style="{StaticResource Divider}"/>

                <!-- ===== بخش QR CODE ===== -->
                <StackPanel HorizontalAlignment="Center" Margin="0,8,0,12">

                    <!-- عنوان بخش QR Code -->
                    <TextBlock Text="QR Code فاکتور"
                               FontSize="11" Foreground="#757575"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <!-- نمایش تصویر QR Code -->
                    <!-- اسکن این QR Code اطلاعات کامل فاکتور را نشان می‌دهد -->
                    <Border BorderBrush="#E0E0E0" BorderThickness="1"
                            CornerRadius="8" Padding="8"
                            HorizontalAlignment="Center">
                        <Image x:Name="imgQRCode"
                               Width="150" Height="150"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <!-- NearestNeighbor: بهترین کیفیت برای QR Code های pixel-based -->
                    </Border>

                    <!-- راهنمای اسکن -->
                    <TextBlock Text="برای مشاهده جزئیات فاکتور اسکن کنید"
                               FontSize="10" Foreground="#9E9E9E"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
                <!-- ===== پایان بخش QR CODE ===== -->

                <!-- متن پاورقی فروشگاه -->
                <TextBlock x:Name="txtFooter"
                           FontSize="11" Foreground="#9E9E9E"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,4,0,0"/>

                <!-- متن تشکر -->
                <TextBlock Text="با تشکر از خرید شما"
                           FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="#1565C0" Margin="0,8,0,4"/>

            </StackPanel>
        </ScrollViewer>

        <!-- دکمه‌های عملیاتی پایین پنجره -->
        <Border Grid.Row="1" Background="#F5F7FA"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <!-- دکمه چاپ -->
                <Button x:Name="btnPrint" Content="🖨 چاپ رسید"
                        Click="BtnPrint_Click"
                        Width="130" Height="36"
                        Background="#1565C0" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        FontFamily="Vazir, Segoe UI" FontSize="13">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="12,6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1976D2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- دکمه ذخیره QR Code -->
                <Button x:Name="btnSaveQR" Content="💾 ذخیره QR Code"
                        Click="BtnSaveQR_Click"
                        Width="140" Height="36"
                        Margin="10,0,0,0"
                        Background="#2E7D32" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        FontFamily="Vazir, Segoe UI" FontSize="13">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="12,6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#388E3C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- دکمه بستن -->
                <Button Content="✕ بستن"
                        Click="BtnClose_Click"
                        Width="90" Height="36"
                        Margin="10,0,0,0"
                        Background="#757575" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        FontFamily="Vazir, Segoe UI" FontSize="13">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="12,6">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>
