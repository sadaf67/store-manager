<Page x:Class="StoreManager.UI.Views.InvoicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}" FontFamily="Vazir, Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="از تاریخ:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker x:Name="dpFrom" Width="130"/>
                <TextBlock Text="تا:" Margin="10,0,6,0" VerticalAlignment="Center"/>
                <DatePicker x:Name="dpTo" Width="130"/>
                <ComboBox x:Name="cbType" Width="120" Margin="10,0,0,0">
                    <ComboBoxItem Content="همه" IsSelected="True"/>
                    <ComboBoxItem Content="فروش"/>
                    <ComboBoxItem Content="خرید"/>
                    <ComboBoxItem Content="برگشت"/>
                </ComboBox>
                <Button Style="{StaticResource PrimaryButton}" Content="فیلتر"
                        Margin="8,0,0,0" Click="BtnFilter_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DataGrid x:Name="dgInvoices" MouseDoubleClick="DgInvoices_DoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="شماره" Binding="{Binding InvoiceNo}" Width="100"/>
                    <DataGridTextColumn Header="نوع" Binding="{Binding TypeName}" Width="80"/>
                    <DataGridTextColumn Header="تاریخ" Binding="{Binding Date, StringFormat={}{0:yyyy/MM/dd}}" Width="100"/>
                    <DataGridTextColumn Header="مشتری" Binding="{Binding CustomerName}" Width="*"/>
                    <DataGridTextColumn Header="مبلغ کل" Binding="{Binding FinalAmount, StringFormat={}{0:N0}}" Width="110"/>
                    <DataGridTextColumn Header="پرداختی" Binding="{Binding PaidAmount, StringFormat={}{0:N0}}" Width="110"/>
                    <DataGridTextColumn Header="مانده" Binding="{Binding RemainAmount, StringFormat={}{0:N0}}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
