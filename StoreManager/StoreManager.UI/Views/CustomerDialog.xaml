<Window x:Class="StoreManager.UI.Views.CustomerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اطلاعات مشتری" Width="420" Height="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FontFamily="Vazir, Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="کد مشتری" Margin="0,0,0,4"/>
            <TextBox x:Name="txtCode" Margin="0,0,0,10"/>
            <TextBlock Text="نام کامل *" Margin="0,0,0,4"/>
            <TextBox x:Name="txtName" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="موبایل" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtMobile"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="تلفن" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtPhone"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="آدرس" Margin="0,0,0,4"/>
            <TextBox x:Name="txtAddress" Height="60" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="سقف اعتبار" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtCredit" Text="0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="کد ملی" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtNational"/>
                </StackPanel>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Style="{StaticResource SuccessButton}" Content="ذخیره" Width="100" Click="BtnSave_Click"/>
            <Button Content="انصراف" Width="80" Margin="8,0,0,0" Click="BtnCancel_Click"
                    Background="#EEE" Foreground="{StaticResource TextBrush}" BorderThickness="0" Padding="8,6" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
